# Значения для локального запуска. На Render всё это задаётся в Environment.
# Скопируйте файл в .env и подставьте свои значения (в .gitignore).

# Postgres на Render; локально можно оставить пустым — возьмётся SQLite.
DATABASE_URL=

# Случайная строка, минимум 32 символа. На Render генерируется автоматически.
SECRET_KEY=dev-local-secret-change-me-0123456789

# Токен админ-методов (/api/admin/*). Пустой = админка выключена.
ADMIN_TOKEN=dev-admin-token

# 1 = регистрация открыта, 0 = только по приглашениям
ALLOW_REGISTRATION=1

# Время жизни токена в секундах (12 часов)
TOKEN_TTL_SECONDS=43200

# Откуда отдавать клиент: локальный файл или внешний URL
JAR_PATH=static/aurum.jar
JAR_URL=

# Для локальной разработки порт читается отсюда, на Render — из окружения
PORT=8000
