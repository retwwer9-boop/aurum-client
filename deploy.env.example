# Скопируйте в deploy.env и впишите токены. Файл в .gitignore — в GitHub не попадает.
# deploy_render.py и publish_assets.py читают его автоматически.

# GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Права: repo (создание приватного репозитория и пуш).
GITHUB_TOKEN=ghp_вставьте_сюда

# Render → Account Settings → API Keys.
# Права: создать сервис, Postgres, менять Environment.
RENDER_API_KEY=rnd_вставьте_сюда

# Необязательно: имена ресурсов
# GITHUB_REPO=aurum-client
# RENDER_SERVICE_NAME=aurum-auth
# RENDER_DB_NAME=aurum-db
# RENDER_REGION=frankfurt
